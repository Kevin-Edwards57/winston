# Required for local session security. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
WINSTON_SECRET_KEY=
WINSTON_DATABASE=winston.db
WINSTON_ZERO_COST_MODE=true

# Phase 3 zero-cost AI providers (not active yet)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
WINSTON_ENABLE_CLAUDE=false
CLAUDE_MODEL=claude-sonnet-4-6

# Existing integrations
GOOGLE_PLACES_KEY=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
ANTHROPIC_KEY=

# ── Send safety ────────────────────────────────────────────
# Dry-run is ON unless explicitly set to false. When true, no SMTP call is made.
WINSTON_DRY_RUN=true
WINSTON_SEND_MIN_INTERVAL=30
WINSTON_SEND_MAX_PER_DAY=50

# ── AI routing ─────────────────────────────────────────────
# Light tasks (classification, extraction) use the smaller local model.
OLLAMA_LIGHT_MODEL=llama3.2:3b

# ── Server ─────────────────────────────────────────────────
# macOS ControlCenter (AirPlay Receiver) occupies port 5000.
WINSTON_PORT=5001
WINSTON_HOST=127.0.0.1
